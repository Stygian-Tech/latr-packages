        },
        {
          "name": "InvalidToken"
        },
        {
          "name": "InvalidDpop"
        },
        {
          "name": "ClientAuthRequired"
        },
        {
          "name": "SavedItemNotFound"
        },
        {
          "name": "Conflict"
        },
        {
          "name": "RateLimitExceeded"
        },
        {
          "name": "UpstreamFailure"
        }
      ]
    }
  }
